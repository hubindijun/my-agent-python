# ============================================
# LiteLLM Proxy 环境变量模板
#
# 使用方法：
#   cp litellm.env.example litellm.env
#   然后填入真实值
#
# 注意：litellm.env 包含敏感信息，已加入 .gitignore，不要提交到仓库
# ============================================

# LiteLLM Master Key（管理 UI 和管理员 API 用，务必改为随机字符串）
LITELLM_MASTER_KEY=sk-litellm-master-change-me

# 应用层 API Key（后端 .env 中 LITELLM_API_KEY 对应的值）
LITELLM_APP_KEY=sk-my-app-proxy-key

# DeepSeek API Key（替换为真实 key）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 第二个 DeepSeek Key（高可用/扩容用，启用双 key 时填写）
# DEEPSEEK_API_KEY_2=sk-your-second-deepseek-key

# Anthropic API Key（启用 Claude 时填写）
# ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API Key（启用 GPT 时填写）
# OPENAI_API_KEY=sk-xxx

# ============================================
# Postgres 数据库（共享状态存储：密钥、成本、调用日志）
# ============================================
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me-to-strong-password
POSTGRES_DB=litellm

# 注意：DATABASE_URL 由 docker-compose 根据上面的变量自动拼接，
# 一般不需要手动修改。如需使用外部 Postgres，取消注释并填写完整连接串：
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================
# Redis（全局限流计数 + 缓存）
# ============================================
# 启用后限流计数在 Redis 中全局维护，多实例部署时计数一致。
# 单点部署也建议开启，平滑升级集群无需改动。
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================
# 其他配置
# ============================================

# 日志级别: DEBUG / INFO / WARNING / ERROR
LITELLM_LOG=INFO
